---
/**
 * Schermata di caricamento statica del configuratore: è nell'HTML, quindi si
 * vede subito, mentre il browser scarica il JavaScript del 3D. Quando la scena
 * è pronta l'isola React la fa sparire (id="cfg-boot").
 */
import Wordmark from './Wordmark.astro';

interface Props {
  testo: string;
}
const { testo } = Astro.props;
---

<div class="boot" id="cfg-boot" role="status" aria-live="polite">
  <div class="boot__centro">
    <Wordmark dimensione="grande" />
    <div class="boot__barra" aria-hidden="true"><span class="boot__corsa" id="cfg-boot-corsa"></span></div>
    <p class="boot__testo">{testo}</p>
  </div>
</div>

<style>
  .boot {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    place-items: center;
    background:
      radial-gradient(50% 40% at 50% 45%, rgba(var(--oro-rgb), 0.08), transparent 70%),
      var(--nero);
  }
  .boot__centro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-5);
  }
  .boot__barra {
    position: relative;
    width: 180px;
    height: 1px;
    overflow: hidden;
    background: var(--filo-forte);
  }
  /* avanzamento: scaleX pilotato dal JS; finché il JS non parte, scorre da solo */
  .boot__corsa {
    position: absolute;
    inset: 0;
    background: var(--oro);
    transform-origin: left center;
    animation: boot-corsa 1.6s var(--ease-out) infinite;
  }
  .boot__corsa.is-misurata {
    animation: none;
    transform: scaleX(var(--avanzamento, 0));
    transition: transform 400ms var(--ease-out);
  }
  .boot__testo {
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--testo-3);
  }
  @keyframes boot-corsa {
    0% {
      transform: translateX(-100%) scaleX(0.4);
    }
    100% {
      transform: translateX(100%) scaleX(0.4);
    }
  }
</style>
