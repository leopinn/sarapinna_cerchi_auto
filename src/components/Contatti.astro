---
import { site } from '../data/site';
import FormContatti from './FormContatti.astro';
import { linguaDa, testi } from '../i18n/index';

const t = testi[linguaDa(Astro.url.pathname)].contatti;

// si mostrano solo i dati già forniti (vedi src/data/site.ts)
const blocchi = [
  site.email && { etichetta: t.email, testo: site.email, href: `mailto:${site.email}` },
  site.telefono && site.telefonoRaw && { etichetta: t.telefono, testo: site.telefono, href: `tel:${site.telefonoRaw}` },
  site.instagram && { etichetta: t.instagram, testo: '@' + site.instagram.replace(/\/+$/, '').split('/').pop(), href: site.instagram, esterno: true },
  site.sede && { etichetta: t.sede, testo: site.sede },
].filter(Boolean) as { etichetta: string; testo: string; href?: string; esterno?: boolean }[];
---

<section class="contatti">
  <div class="contatti__fondo" aria-hidden="true"></div>
  <div class="container contatti__griglia">
    <div class="contatti__intro">
      <p class="occhiello" data-reveal-hero>{t.occhiello}</p>
      <h1 data-reveal-hero>{t.titolo}</h1>
      <p class="contatti__testo" data-reveal-hero>{t.testo}</p>

      {blocchi.length > 0 && (
        <dl class="contatti__blocchi" data-reveal>
          {blocchi.map((b) => (
            <div class="contatti__blocco">
              <dt>{b.etichetta}</dt>
              <dd>
                {b.href ? (
                  <a href={b.href} target={b.esterno ? '_blank' : undefined} rel={b.esterno ? 'noopener' : undefined}>{b.testo}</a>
                ) : (
                  b.testo
                )}
              </dd>
            </div>
          ))}
        </dl>
      )}
    </div>

    <FormContatti />
  </div>
</section>

<style>
  .contatti {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    padding: calc(var(--nav-h) + var(--s-9)) 0 var(--s-10);
  }
  .contatti__fondo {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(50% 40% at 85% 10%, rgba(var(--oro-rgb), 0.09), transparent 70%),
      radial-gradient(60% 50% at 0% 90%, rgba(52, 54, 60, 0.45), transparent 70%);
  }
  .contatti__griglia {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--s-9);
    align-items: start;
  }
  .contatti__intro {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    position: sticky;
    top: calc(var(--nav-h) + var(--s-7));
  }
  .contatti__testo {
    max-width: 30em;
    color: var(--testo-2);
  }
  .contatti__blocchi {
    display: flex;
    flex-direction: column;
    margin: var(--s-5) 0 0;
  }
  .contatti__blocco {
    display: grid;
    grid-template-columns: 9em 1fr;
    gap: var(--s-4);
    padding: var(--s-4) 0;
    box-shadow: inset 0 -1px 0 var(--filo);
  }
  .contatti__blocco dt {
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--testo-3);
    padding-top: 2px;
  }
  .contatti__blocco dd {
    margin: 0;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 600;
    font-size: 15px;
  }
  .contatti__blocco a {
    color: var(--testo);
  }
  .contatti__blocco a:hover {
    color: var(--oro-chiaro);
  }

  @media (max-width: 1023px) {
    .contatti__griglia {
      grid-template-columns: 1fr;
      gap: var(--s-7);
    }
    .contatti__intro {
      position: static;
    }
  }
  @media (max-width: 760px) {
    .contatti {
      padding-top: calc(var(--nav-h) + var(--s-7));
    }
    .contatti__blocco {
      grid-template-columns: 1fr;
      gap: var(--s-1);
    }
  }
</style>
