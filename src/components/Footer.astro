---
import Wordmark from './Wordmark.astro';
import { site } from '../data/site';
import { linguaDa, testi } from '../i18n/index';

const lingua = linguaDa(Astro.url.pathname);
const t = testi[lingua];
const f = t.footer;
const anno = new Date().getFullYear();
const contatti = [
  site.email && { href: `mailto:${site.email}`, testo: site.email },
  site.telefono && site.telefonoRaw && { href: `tel:${site.telefonoRaw}`, testo: site.telefono },
  site.instagram && { href: site.instagram, testo: 'Instagram', esterno: true },
].filter(Boolean) as { href: string; testo: string; esterno?: boolean }[];
---

<footer class="footer">
  <div class="container">
    <div class="footer__griglia">
      <div class="footer__marchio">
        <a href={t.nav.home.href} aria-label="SP Design — Home"><Wordmark /></a>
        <p>{f.testo}</p>
      </div>
      <nav class="footer__col" aria-label={f.colonnaSito}>
        {[t.nav.home, t.nav.configuratore, t.nav.contatti].map((v) => <a href={v.href}>{v.label}</a>)}
      </nav>
      {contatti.length > 0 && (
        <div class="footer__col">
          {contatti.map((c) => (
            <a href={c.href} target={c.esterno ? '_blank' : undefined} rel={c.esterno ? 'noopener' : undefined}>{c.testo}</a>
          ))}
        </div>
      )}
    </div>
    <div class="footer__base">
      <span>© {anno} {site.nome} · {f.diritti}</span>
      <p class="footer__marchi">{f.marchi}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding: var(--s-8) 0 var(--s-6);
    background: var(--ant-900);
    box-shadow: inset 0 1px 0 var(--filo);
  }
  .footer__griglia {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--s-7);
  }
  .footer__marchio {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .footer__marchio a {
    align-self: flex-start;
  }
  .footer__marchio a:hover {
    text-decoration: none;
  }
  .footer__marchio p {
    max-width: 28em;
    color: var(--testo-2);
    font-size: 14px;
  }
  .footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .footer__col a {
    align-self: flex-start;
    font-size: 14px;
    color: var(--testo-2);
    transition: transform var(--dur-2) var(--ease-spring);
  }
  .footer__col a:hover {
    color: var(--testo);
    text-decoration: none;
    transform: translateX(3px);
  }
  .footer__col a:active {
    transform: translateX(1px);
  }
  .footer__base {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    margin-top: var(--s-8);
    padding-top: var(--s-5);
    box-shadow: inset 0 1px 0 var(--filo);
    font-size: 12px;
    color: var(--testo-3);
    line-height: 1.6;
  }
  .footer__marchi {
    max-width: 70em;
  }

  @media (max-width: 760px) {
    .footer__griglia {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
  }
</style>
