---
/**
 * Logo ufficiale.
 *  - monogramma: dove lo spazio è poco (header)
 *  - verticale:  monogramma + nome (footer, schermata di caricamento)
 * Il monogramma è oro, la scritta del logo verticale chiara.
 */
import { LOGO_MONOGRAMMA, LOGO_VERTICALE } from '../assets/logo/index';

interface Props {
  variante?: 'monogramma' | 'verticale';
  /** altezza in px */
  altezza?: number;
}
const { variante = 'monogramma', altezza = variante === 'monogramma' ? 40 : 96 } = Astro.props;
---

<span class:list={['marchio', `marchio--${variante}`]} style={`--marchio-h: ${altezza}px`} set:html={variante === 'monogramma' ? LOGO_MONOGRAMMA : LOGO_VERTICALE} />

<style>
  .marchio {
    display: inline-flex;
    line-height: 0;
    color: var(--testo);
  }
  .marchio :global(svg) {
    height: var(--marchio-h);
    width: auto;
    max-width: none;
  }
  .marchio--monogramma {
    color: var(--oro);
  }
  /* logo verticale: monogramma oro, nome chiaro */
  .marchio--verticale :global(g:first-of-type) {
    fill: var(--oro);
  }
</style>
